# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# Leave empty in development (Vite proxy handles routing to the backend).
# In production, set this to your API's base URL:
#   VITE_API_URL=https://api.scubahub.com
VITE_API_URL=

# --- Production server (server.js) runtime config ---

# API base URL injected into index.html as window.__ENV__.API_URL at runtime.
API_URL=

# SHA-256 thumbprint of the pinned Cloudflare client certificate. Required:
# server.js refuses to start without it. Forwarded by Cloudflare Zero Trust in
# the x-arr-clientcert header; every request whose cert thumbprint does not
# match (or is outside its validity window) is rejected with 403.
CF_CLIENT_THUMBPRINT=
